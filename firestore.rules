rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidGardenDesign(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.summary is string && data.summary.size() <= 1000 &&
             data.style is string && data.style.size() >= 1 && data.style.size() <= 80 &&
             data.widthFeet is number && data.widthFeet >= 2 && data.widthFeet <= 500 &&
             data.lengthFeet is number && data.lengthFeet >= 2 && data.lengthFeet <= 500 &&
             data.sunlight is string && data.sunlight.size() >= 1 && data.sunlight.size() <= 60 &&
             data.soilType is string && data.soilType.size() >= 1 && data.soilType.size() <= 60 &&
             data.climateZone is string && data.climateZone.size() >= 1 && data.climateZone.size() <= 60 &&
             data.hardscapeZones is list && data.hardscapeZones.size() <= 20 &&
             (data.hardscapeZones.size() == 0 || data.hardscapeZones[0] is map) &&
             data.plants is list && data.plants.size() <= 60 &&
             (data.plants.size() == 0 || data.plants[0] is map) &&
             (!('conceptVisualPath' in data) || (data.conceptVisualPath is string && data.conceptVisualPath.size() <= 300));
    }

    match /users/{userId}/gardens/{gardenId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(gardenId) && request.auth.uid == userId;
      allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(gardenId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'summary', 'style',
                         'widthFeet', 'lengthFeet', 'sunlight', 'soilType', 'climateZone',
                         'hardscapeZones', 'plants', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'summary', 'style',
                         'widthFeet', 'lengthFeet', 'sunlight', 'soilType', 'climateZone',
                         'hardscapeZones', 'plants', 'conceptVisualPath', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidGardenDesign(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(gardenId) &&
                       request.auth.uid == userId &&
                       isValidGardenDesign(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'summary', 'style',
                         'widthFeet', 'lengthFeet', 'sunlight', 'soilType', 'climateZone',
                         'hardscapeZones', 'plants', 'conceptVisualPath', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && isValidId(gardenId) && request.auth.uid == userId;
    }
  }
}
